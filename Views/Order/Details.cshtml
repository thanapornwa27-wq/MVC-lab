@model Order

<h1>Order Details</h1>

<dl class="row">
    <dt class="col-sm-2">OrderId</dt>
    <dd class="col-sm-10">@Model.OrderId</dd>

    <dt class="col-sm-2">ProductId</dt>
    <dd class="col-sm-10">@Model.ProductId</dd>

    <dt class="col-sm-2">Quantity</dt>
    <dd class="col-sm-10">@Model.Quantity</dd>

    <dt class="col-sm-2">Total</dt>
    <dd class="col-sm-10">@Model.Total</dd>

    <dt class="col-sm-2">Address</dt>
    <dd class="col-sm-10">@Model.Address</dd>
</dl>

<a asp-action="Index">Back to List</a>
